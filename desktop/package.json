{
  "name": "interview-assistant-desktop",
  "version": "1.0.0",
  "description": "智能面试学习辅助助手 - Electron 桌面端",
  "appDisplayName": "智能面试学习辅助助手",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64",
    "dist:dir": "electron-builder --win --x64 --dir"
  },
  "devDependencies": {
    "electron": "^41.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.interviewassistant.desktop",
    "productName": "Interview Assistant",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "shortcuts.js",
      "windowOptions.js",
      "multiScreenBatch.js",
      "runtimePaths.js",
      "app-title.json",
      "icon.png"
    ],
    "extraResources": [
      {
        "from": "../backend/api",
        "to": "backend/api",
        "filter": [
          "**/*",
          "!**/__pycache__/**"
        ]
      },
      {
        "from": "../backend/core",
        "to": "backend/core",
        "filter": [
          "**/*",
          "!**/__pycache__/**"
        ]
      },
      {
        "from": "../backend/services",
        "to": "backend/services",
        "filter": [
          "**/*",
          "!**/__pycache__/**"
        ]
      },
      {
        "from": "../backend/assets",
        "to": "backend/assets"
      },
      {
        "from": "../backend/main.py",
        "to": "backend/main.py"
      },
      {
        "from": "../backend/requirements.txt",
        "to": "backend/requirements.txt"
      },
      {
        "from": "../backend/pyproject.toml",
        "to": "backend/pyproject.toml"
      },
      {
        "from": "../backend/config.example.json",
        "to": "backend/config.example.json"
      },
      {
        "from": "../frontend/dist",
        "to": "frontend/dist"
      },
      {
        "from": "../start.py",
        "to": "start.py"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false
    }
  },
  "author": "AI Interview Assistant Contributors"
}
